# Environment variables — Self-Healing Machines (TELIPORT Season 4)
# Copy to .env and fill in real values. NEVER commit .env — only this file.

# --- Pipeline / MLflow -----------------------------------------------------
# MLflow tracking backend (default: sqlite:///./mlflow.db when unset)
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db

# --- API (backend/app/config.py) -------------------------------------------
SHM_DB_PATH=data/shm.db
SHM_SUBSET=FD001
SHM_MODELS_DIR=models
# Comma-separated origins, or * for any (reads are public; writes need the key)
SHM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# REQUIRED for writes. Resolving work orders and retraining need this value in
# the X-API-Token header. When empty the API fails closed: every write returns
# 503. Generate one with:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
SHM_API_TOKEN=

# --- Frontend (frontend/.env.local) ----------------------------------------
VITE_API_URL=http://localhost:8000
# Do NOT add VITE_API_TOKEN. Anything in a Vite bundle is public, so a baked
# token would let any visitor mutate data. The owner pastes the key into the
# "Owner access" button in the dashboard; it is stored in that browser only.
