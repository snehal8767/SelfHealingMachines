# Environment variables — Self-Healing Machines (TELIPORT Season 4)
# Copy to .env and fill in real values. NEVER commit .env — only this file.

# --- Pipeline / MLflow -----------------------------------------------------
# MLflow tracking backend (default: sqlite:///./mlflow.db when unset)
MLFLOW_TRACKING_URI=sqlite:///./mlflow.db

# --- API (backend/app/config.py) -------------------------------------------
SHM_DB_PATH=data/shm.db
SHM_SUBSET=FD001
SHM_MODELS_DIR=models
# Comma-separated origins, or * for any (read-only API; writes use the token)
SHM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Leave empty for the open local demo. Set it to require X-API-Token on writes.
SHM_API_TOKEN=

# --- Frontend (frontend/.env.local) ----------------------------------------
VITE_API_URL=http://localhost:8000
# Must match SHM_API_TOKEN when the API is protected
VITE_API_TOKEN=
