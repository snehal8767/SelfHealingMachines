{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: FastAPI (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Pipeline: train FD001",
      "type": "debugpy",
      "request": "launch",
      "module": "pipeline.train",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Pipeline: sync fleet",
      "type": "debugpy",
      "request": "launch",
      "module": "pipeline.store",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
